# Copy to api/.env (API) and, optionally, web/.env.local (web). NEVER commit real values.
# Not needed at all for local development: `python api/dev.py` runs everything in memory with the demo preloaded.

# --- api ---
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # server-side only
SUPABASE_PUBLISHABLE_KEY=       # public by design; used to validate sign-in tokens
GEMINI_API_KEY=                 # optional: without it the API uses its rule-based mode
LLM_MODE=auto                   # auto (AI with rules fallback) | model | rules
GITHUB_TOKEN=                   # optional: raises the GitHub API rate limit for reading repos
EXPORT_SIGNING_KEY=             # optional: secret for signed exports (a derived key is used if unset)

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
